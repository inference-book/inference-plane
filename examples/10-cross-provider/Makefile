# Demo 10 is a self-contained shell walkthrough -- run.sh starts its own
# control plane and mock engine for the last two acts, so there is no
# separate `make serve`. Needs a prebuilt bin/iplane (`make build` at the
# repo root) and at least one provider API key.

demo: ## Run the cross-provider walkthrough (10a-10f)
	bash run.sh

.PHONY: demo
