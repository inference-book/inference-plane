# Demo 09 is a self-contained shell walkthrough -- run.sh starts its own
# control plane and mock engines, so there's no separate `make serve` or
# DEPLOY_ID. Needs a prebuilt bin/iplane (run `make build` at the repo
# root first).

demo: ## Run the distributed-fleet walkthrough (09a-09d, GPU-free)
	bash run.sh

.PHONY: demo
